AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# To use Groq, set AI_PROVIDER=groq and provide a Groq API key.
# To use GPT instead, set AI_PROVIDER=openai and provide an OpenAI API key.
# Keep the real key in .env; never commit it or paste it into chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
